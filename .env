# Local development example environment variables
# Do NOT commit real secrets. Copy this file to `.env` and fill values.

# Backend
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SESSION_SECRET=change-me-in-dev
ADMIN_PASSWORD=change-me-in-dev

# Payment / email (optional)
PAYSTACK_SECRET_KEY=
REPLIT_CONNECTORS_HOSTNAME=

# Frontend
BASE_PATH=/
